# Supabase Configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Chave Secreta de Administração (Usada APENAS em Server Actions para Reset de Senha e vínculos)
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-secreta"

# Lista de CPFs (apenas 11 números, separados por vírgula) que nascem automaticamente como 'admin' ao preencher o Censo
ADMIN_MASTER_CPFS="00000000000,11111111111"

# Chave de segurança para o Cron Job Keep-Alive (Opcional)
CRON_SECRET="ipcf-keep-alive-secret-2026"
